DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=car_care_db

# ใช้ตอนล็อกอิน (Auth/services/authService.js)
# JWT_SECRET ต้องยาวอย่างน้อย 32 ตัวอักษร ไม่งั้นล็อกอินจะได้ error 500
JWT_SECRET=change_me_to_a_random_string_at_least_32_characters
# อายุของ token เช่น 1h, 8h, 1d
JWT_EXPIRES_IN=8h
PORT=5000
# ตอน deploy หลัง proxy (Railway/Render) ให้ตั้งเป็น 1 เพื่อให้ตัวจำกัดการล็อกอินผิด
# นับตาม IP ของผู้ใช้จริง ไม่ใช่ IP ของ proxy (เครื่องตัวเองไม่ต้องตั้ง)
# TRUST_PROXY=1
